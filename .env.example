# PostgreSQL local (VPS o dev)
DATABASE_URL=postgresql://n10k:CHANGE_ME@localhost:5432/n10k_store

# Fallback a catálogo estático si la DB no responde (default: solo en dev)
# ALLOW_STATIC_CATALOG_FALLBACK=false

# URL pública del sitio (SEO/OG/canónicas) — build-time
NEXT_PUBLIC_SITE_URL=https://n10kstore.com

# Secreto para firmar las sesiones de admin (generar: openssl rand -hex 32)
ADMIN_SESSION_SECRET=CHANGE_ME

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX). Vacío = GA desactivado. build-time
NEXT_PUBLIC_GA_ID=
